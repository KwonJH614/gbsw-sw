MYSQL_DATABASE=hooppath
MYSQL_USER=hooppath
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

JWT_SECRET=change-this-production-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000
APP_CORS_ALLOWED_ORIGINS=https://your-domain.example
NOTIFICATION_SCHEDULE_ENABLED=true
NOTIFICATION_SCHEDULE_CRON=0 0 9 * * *
NOTIFICATION_INACTIVE_DAYS=7

BACKEND_IMAGE=ghcr.io/OWNER/REPOSITORY/backend:deploy-p2-current
FRONTEND_IMAGE=ghcr.io/OWNER/REPOSITORY/frontend:deploy-p2-current
HTTP_PORT=80
